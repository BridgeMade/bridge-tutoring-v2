# Resend — get from resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email addresses
RESEND_FROM_EMAIL=Bridge <noreply@bridgetutoring.co.za>
NOTIFY_EMAIL=team@bridgetutoring.co.za

# Meta WhatsApp Business Cloud API — get from developers.facebook.com
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxx
WHATSAPP_RECIPIENT_NUMBER=27XXXXXXXXXX

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# PostHog — get from posthog.com (Project Settings → Project API Key).
# Both must be NEXT_PUBLIC_ (used client-side). Host: us.i.posthog.com or eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
